{
  "name": "resultater",
  "version": "0.9.18",
  "description": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hesteskokasting/resultater.git"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "typecheck": "tsc -b",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vp test",
    "test:run": "vp test run",
    "preview": "vp preview --host",
    "test:db": "supabase test db",
    "css:check": "node scripts/css-check.mjs",
    "types:gen": "node scripts/gen-types.mjs --linked",
    "types:gen:local": "node scripts/gen-types.mjs --local",
    "android:sync": "cap sync android",
    "android:sync:dev": "cross-env CAPACITOR_SERVER_URL=https://res.hesteskokasting.no/dev cap sync android",
    "android:sync:local": "cross-env CAPACITOR_SERVER_URL=http://10.0.2.2:5173 cap sync android",
    "android:dev": "powershell -ExecutionPolicy Bypass -File scripts/android-dev.ps1",
    "ios:sync": "cap sync ios",
    "ios:sync:dev": "cross-env CAPACITOR_SERVER_URL=https://res.hesteskokasting.no/dev cap sync ios",
    "ios:sync:local": "cross-env CAPACITOR_SERVER_URL=http://localhost:5173 cap sync ios",
    "prepare": "vp config"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-social-login": "^8.3.33",
    "@onesignal/capacitor-plugin": "^1.1.3",
    "@supabase/supabase-js": "^2.105.4",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.10.1",
    "supabase": "^2.93.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plus": "0.2.8"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "warn"
    }
  },
  "buildNumber": 4
}
